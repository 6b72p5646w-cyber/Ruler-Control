    "method_pages": [
      {
        "id": "K01",
        "branch": "拟态核验",
        "title": "工作记录、当前身体与权限分别核对",
        "system_ids": [
          "SG08"
        ],
        "monster_ids": [
          "F02",
          "F38",
          "F43"
        ],
        "event_ids": [],
        "applicable_phenomena": [
          "熟悉同事的身体、声音或工作请求出现不一致",
          "历史记录真实，但当前来者是否与记录中的人连续对应仍待核"
        ],
        "method_steps": [
          "查看原始工作回执，按根来源归并重印件。",
          "把记录中的时段与实际连续观察对照；不够时保留钥匙和原工单。",
          "只恢复证据支持的有限权限，拒绝越界请求不等于宣布对方是假身。"
        ],
        "limits": [
          "记录曾经做过工作，不能单独证明眼前身体。",
          "本页不读取隐藏真身，不把宠物反应算独立身份认证。"
        ]
      },
      {
        "id": "K02",
        "branch": "门槛与邀约",
        "title": "门牌、迎宾声道和员工权限是三件事",
        "system_ids": [
          "SG01",
          "SG10"
        ],
        "monster_ids": [
          "F32",
          "F36",
          "F48"
        ],
        "event_ids": [],
        "applicable_phenomena": [
          "来客停在门槛或要求借用员工通道",
          "已经说出欢迎语后，玩家想改变接待方式"
        ],
        "method_steps": [
          "分别查看营业牌、迎宾声道及本次实际邀请记录。",
          "按该遭遇给出的实体边界和纸条限定区域、对象与期限。",
          "收回许可后检查同一来客与原槽；不把关声道当作撤销既有邀请。"
        ],
        "limits": [
          "边界只对明确适用的本怪规则生效。",
          "不能用门牌自动清除店内追逐，也不能把员工帽当授权。"
        ]
      },
