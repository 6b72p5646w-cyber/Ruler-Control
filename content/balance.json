        ],
        "method_steps": [
          "接受前列出这一次对象、份量、范围、截止和退出代价。",
          "履行时沿用同一物件与接受回执；观察完整预算，报价截止后不补接受。",
          "完成、取消、到期分开记；实际交易才给收入，不重复使用同一承诺编号。"
        ],
        "limits": [
