    "drop_carried_item",
    "toggle_safe_door",
    "use_emergency_item"
  ],
  "common_modifier_policy": {
    "event_precision_multiplier_min": 0.85,
    "max_event_precision_modifiers": 1,
    "precision_bonus_fraction_max": 0.12,
    "same_category_buff_stacking": "strongest_only",
    "illumination_changes_san_value": false,
    "target_scale_multiplier_max": 1.12,
    "precision_increase_combination": "strongest_single_increase_not_sum",
    "pet_multiplier_contribution_capped_at_normal_target": true,
    "task_seconds_bonus_policy": "只有列入task_profiles的专属效果可用秒数加成；在无辅助判定窗下限之后增加，与通用强化取最强，最终受同一上限约束。普通比例加成仍最多0.12。"
  },
  "closeup_time_policy": {
    "world_and_threat_timers_frozen": true,
    "local_qte_timer_runs": true,
    "admit_only_if_no_active_chase": true,
    "admit_only_if_no_pending_hit": true,
    "admit_only_if_spatial_rules_satisfied": true,
    "reserve_attempt_cost_before_entry": true,
    "cancel_and_failure_consume_advertised_attempt_cost": true,
    "settle_game_clock_and_work_resource_cost_once_on_exit": true,
    "replay_unseen_enemy_movement_or_damage_on_exit": false,
    "admit_only_if_attempt_fits_remaining_phase": true,
    "open_close_loop_grants_work_or_recovery": false,
    "system_pause_freezes_local_qte_too": true,
    "read_only_preparation_is_not_started_attempt": true,
    "press_start_is_first_committed_input": true,
    "cost_reserved_on_start_charged_once_on_exit": true,
    "schedule_clock": "phase_budget_elapsed",
    "world_clock": "world_simulation",
    "must_not_cross_next_undispatched_schedule_marker": true,
    "equal_boundary_commits_action_then_dispatches_marker": true,
    "critical_remaining_resolution_budget_must_still_fit": true,
    "handover_actions_are_separate_from_world_pause": true,
    "condition_clock_contract": "content/condition_lifecycle_v06.json#/clock_contract"
  },
  "task_profiles": [
    {
      "id": "F47_song",
      "template_id": "QT01",
      "cycle_seconds": 3,
