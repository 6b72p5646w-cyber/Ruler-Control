      "monster_patch": {
        "adaptation_notice": "本作原创：库房生肉目标、触肉后转追玩家、搬入冰柜解除。沿用夜间觅食原型作为灵感，不再使用厨余封袋或气味路径作为本怪胜利条件。",
        "signature_interaction": "生肉抢运：飞头女鬼先追一箱库房任务生肉；若触肉则预告后转追玩家。玩家拿起该箱生肉，送到标明且可用的冰柜，完成存入并关门，即解除本次遭遇；抢先入柜也可直接成功。",
        "evidence": [
          "入场目标标记指向任务生肉，玩家提起箱子后目标随箱子移动。",
          "触到未入柜生肉后先有变色与蓄势，随后目标改为玩家；放下肉不取消追杀。"
        ],
        "safe_response": "预先开好到冰柜的通路，使用独立任务携带槽搬一箱肉。体力耗尽仍可步行和存入，生肉不会被怪物吃掉而丢失。存入并关门在大地图一步提交，成功后本实例不再因普通开柜或停电复活。",
        "resource_effects": {
          "energy": "沿用搬运工作成本，不为触肉另加隐形时间惩罚。",
          "san": "受击按共享追逐规则结算，触肉升级先有明确预告。",
          "satiety": "任务肉属于库存；移动、入柜或污染不直接扣主角已获得的饱腹。",
          "stamina": "普通携带、拾取与入柜无硬体力门槛，重负荷或冲刺按统一行动配置。"
        },
        "synergy_conditions": {
          "harder": "任务箱换库位、门关闭或少量湿地改变抢运路线；唯一目标冰柜失效且无替代时禁止投放。",
          "easier": "P02黑犬可在CHASE_PLAYER追逐态将飞头女鬼移动速度降低30%，持续4秒，不回退怒态或直接解除。落地灯、挡板等帮助搬运，保温袋和垃圾封口不能替代入柜目标。F12/F26的第二主动追逐者首版排除。"
        },
