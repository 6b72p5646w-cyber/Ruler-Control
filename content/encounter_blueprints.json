              "to": "CLEARED"
            },
            {
              "trigger": "reached_bait",
              "to": "EAT_BAIT"
            },
            {
              "trigger": "bait_invalid",
              "to": "CHASE_PLAYER",
              "action": "reselect_on_next_tick"
            }
          ]
        },
        {
          "id": "EAT_BAIT",
          "target": "none",
          "transitions": [
            {
              "trigger": "whole_collider_inside_exit_success_zone_for_hold",
              "guard": "currently_lured_to_bait",
              "to": "CLEARED"
            },
            {
              "trigger": "eat_timer_complete",
              "to": "CHASE_PLAYER",
              "action": "consume_bait_then_reselect"
            }
          ]
        },
        {
          "id": "CLEARED",
          "terminal": true,
          "actions": [
            "clear_target",
            "leave_scene",
            "settle_once"
          ]
        }
      ],
      "success_predicate": "state in {SEEK_BAIT,EAT_BAIT} and whole_body_in_marked_outdoor_exit_zone for 0.25 seconds",
