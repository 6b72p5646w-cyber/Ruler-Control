        "aim_included_in_interval": true
      },
      "core": "沿实际无遮挡直线命中最多两个独立血池；第二个只承受60%原始伤害。25个百分点穿甲是明确属性，不由单发大自动获得。装填完成可保留一发，切换目标不刷新装填。",
      "favorable_conditions": [
        "短暂开甲窗口",
        "高物理防御、较稳定路线",
        "把两敌排成直线"
      ],
      "unfavorable_conditions": [
        "绕货架急转导致射线中断",
        "多路分散小体目标",
        "长装填期间的连续贴身压力"
      ],
      "skills": [
        {
          "id": "T01A_S1",
